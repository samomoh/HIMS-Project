# Copy to .env.local for local development. Replace every placeholder with a secret value.
DATABASE_URL=
DATABASE_SSL=false
SESSION_SECRET=
APP_URL=http://localhost:3000
RESEND_API_KEY=
RESET_EMAIL_FROM=

# Optional clinical assistant connection (server-only; never expose in browser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Local/staging RBAC walkthrough only. Keep disabled in production.
ENABLE_DEMO_ACCOUNTS=false
ALLOW_DEMO_ACCOUNTS=false
DEMO_ACCOUNTS_PASSWORD=

# Set only for the one-time initial administrator setup, then remove.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Set to "true" only when running the destructive sample seed against a disposable database.
ALLOW_DESTRUCTIVE_SEED=false
